PORT=7860
DATA_DIR=./data
# Set PUBLIC_URL to the final HTTPS application URL when the host rewrites Host.
# PUBLIC_URL=https://your-application.example
# For an HTTPS app embedded on a different site (for example ModelScope):
# SESSION_COOKIE_MODE=embedded
# Platform defaults require a private server-side key. Leave blank for BYOK use.
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_MAX_INPUT_CHARS=400000
MODEL_MAX_OUTPUT_TOKENS=16000
# Optional: persistent secrets are generated in DATA_DIR when these are absent.
# SESSION_SECRET=at-least-32-random-characters
# MODEL_CONFIG_ENCRYPTION_KEY=standard-base64-encoded-32-byte-random-key
